{
  "launch": {
    "name": "Auto Debug (Smart File Detection)",
    "type": "auto-debug",
    "request": "launch",
    "map": {
      "*.ino": "Arduino: Run .ino with FastLED",
      "*.py": "Python: Current File (UV)"
    }
  },
  "tasks": [
    {
      "type": "shell",
      "label": "Run FastLED (Debug)",
      "command": "fastled",
      "args": [
        "${file}",
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "detail": "Run FastLED with debug mode and Tauri visualization",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Run FastLED (Quick)",
      "command": "fastled",
      "args": [
        "${file}",
        "--quick"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "detail": "Run FastLED with quick build mode",
      "problemMatcher": []
    }
  ]
}
